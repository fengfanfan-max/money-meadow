{
  "name": "money-meadow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Money Meadow — playful money-skills mini-games for kids. Tablet-first, keyboard accessible, no data collection.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:network": "node scripts/check-no-network.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "fetch-fonts": "node scripts/fetch-fonts.mjs",
    "verify": "pnpm typecheck && pnpm check:contrast && pnpm test && pnpm build && pnpm check:network"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
